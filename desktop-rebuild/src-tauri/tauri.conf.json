{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "破甲",
  "version": "0.1.0",
  "identifier": "cn.pojia.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "破甲",
        "width": 1600,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "../../icon.ico"
    ]
  }
}
